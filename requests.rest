# requests.rest
# REST Client script to test API routes.
@baseUrl = http://localhost:3001/api
### Get all blogs
GET {{baseUrl}}/blogs

### Add a new blog (Success case)
POST {{baseUrl}}/blogs
Content-Type: application/json

{
  "author": "Rest Client Test 1",
  "url": "https://restclienttest1.org/",
  "title": "REST Client testing from VSCode",
  "likes": 42
}

### Test POST error handling: Add a blog with missing required field (Failure/Validation test)
POST {{baseUrl}}/blogs
Content-Type: application/json

{
  "author": "Rest Client Test X"
}

### Update the likes of a specific blog, by id (/id)
PUT {{baseUrl}}/blogs/4
Content-Type: application/json

{
  "likes": 40
}

### Test PUT error handling (Invalid likes data type)
PUT {{baseUrl}}/blogs/4
Content-Type: application/json

{
  "likes": "not-a-number"
}

### Delete a blog by valid existing id (/id). 
# Use 'Get all blogs' to identify blog to delete
DELETE {{baseUrl}}/blogs/4

### Delete a blog with valid non-existing id.
# Triggers the blogFinder guard clause: if (!req.blog) return 404
DELETE {{baseUrl}}/blogs/999999

### Delete a blog by malformed id (400 Bad Request test)
# Triggers the blogFinder catch block. PostgreSQL cannot query an int column with a string.
DELETE {{baseUrl}}/blogs/abc

### Get all users
GET {{baseUrl}}/users

### Create a new user (inc. password field that should be ignored)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "username": "jimcricket",
  "name": "Jim Cricket",
  "password": "secret"
}

### Get a single user by ID (replace 1 with user id from the Db)
GET {{baseUrl}}/users/1

### Update a user's name by username (replace jimcricket with valid username)
PUT {{baseUrl}}/users/jimcricket
Content-Type: application/json

{
  "name": "Jimmy Cricket"
}