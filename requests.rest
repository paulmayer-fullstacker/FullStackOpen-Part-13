# requests.rest
# REST Client script to test API routes.
@baseUrl = http://localhost:3001/api/blogs
### Get all blogs
GET {{baseUrl}}

### Add a new blog (Success case)
POST {{baseUrl}}
Content-Type: application/json

{
  "author": "Rest Client Test 1",
  "url": "https://restclienttest1.org/",
  "title": "REST Client testing from VSCode",
  "likes": 42
}

### Add a blog with missing required field (Failure/Validation test)
POST {{baseUrl}}
Content-Type: application/json

{
  "author": "Rest Client Test X"
}

### Update the likes of a specific blog, by id (/id)
PUT {{baseUrl}}/1
Content-Type: application/json

{
  "likes": 5
}

### Delete a blog by valid existing id (/id). 
# Use 'Get all blogs' to identify blog to delete
DELETE {{baseUrl}}/6

### Delete a blog with valid non-existing id.
# Triggers the blogFinder guard clause: if (!req.blog) return 404
DELETE {{baseUrl}}/999999

### Delete a blog by malformed id (400 Bad Request test)
# Triggers the blogFinder catch block. PostgreSQL cannot query an int column with a string.
DELETE {{baseUrl}}/abc